# Copied to .env by ./start.sh on first run. Change ports here if they clash
# with something already running on your machine.
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional. With a key, "What could you build here?" reads a plan written in plain
# words and writes a short cited answer. Without it the form still works and the
# answer is the deterministic table and card list.
# The provider is read from the key: v1. (Nebius Token Factory, the default we run on),
# nvapi- (NVIDIA NIM), sk-or- (OpenRouter), sk-ant- (Anthropic). Leave ZONING_MODEL empty
# for the provider's default: nvidia/nemotron-3-super-120b-a12b on Token Factory.
LLM_API_KEY=
ZONING_MODEL=
# For another OpenAI-style endpoint: LLM_PROVIDER=openai and LLM_BASE_URL=https://.../v1
# Vision model for the photo labels and the house profiles, and the embedding model for
# "similar homes"; empty = the provider's defaults (nvidia/Nemotron-3.5-Super-VL and
# Qwen/Qwen3-Embedding-8B on Token Factory).
PHOTO_MODEL=
PROFILE_MODEL=
EMBED_MODEL=
