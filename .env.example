# Copied to .env by ./start.sh on first run. Change ports here if they clash
# with something already running on your machine.
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional. With a key, "What could you build here?" reads a plan written in plain
# words and writes a short cited answer. Without it the form still works and the
# answer is the deterministic table and card list.
# The provider is read from the key: v1. (Nebius Token Factory, the default we run on),
# nvapi- (NVIDIA NIM), sk-or- (OpenRouter), sk-ant- (Anthropic). Leave ZONING_MODEL empty
# for the provider's default: nvidia/nemotron-3-super-120b-a12b on Token Factory.
LLM_API_KEY=
ZONING_MODEL=
# Optional fallback: an OpenRouter key (sk-or-). OpenRouter serves the same open models, so it
# answers when Token Factory refuses or fails (no credit, a rejected key, a rate limit, a 5xx).
# Token Factory is always tried first; GET /api/health shows how often the fallback answered.
LLM_FALLBACK_API_KEY=
# For another OpenAI-style endpoint: LLM_PROVIDER=openai and LLM_BASE_URL=https://.../v1
# Vision model for the photo labels and the house profiles, and the embedding model for
# "similar homes"; empty = the provider's defaults (nvidia/Nemotron-3.5-Super-VL and
# Qwen/Qwen3-Embedding-8B on Token Factory).
PHOTO_MODEL=
PROFILE_MODEL=
EMBED_MODEL=

# Spend guards (backend/app/guard.py): model calls per UTC day across the service, and per
# client address per hour. -1 turns a cap off. See docs/deploy.md, "Spend guards".
MODEL_DAILY_CAP=500
MODEL_IP_HOURLY_CAP=60

# Cloudflare Turnstile (free) in front of the session cookie, which in turn gates every
# paid model call a visitor can trigger. Empty = no check, unsigned cookie (fine for
# development). Production sets all 3; SESSION_SECRET is any long random string
# (`openssl rand -hex 32`) and signs the cookie so a script cannot forge one.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SESSION_SECRET=
