graph LR
  subgraph machine["Your machine"]
    browser["Browser"]
    start["start.sh"]
    fe["frontend: Next.js 16<br/>App Router, :3000<br/>runs outside Docker"]
  end

  subgraph compose["Docker Compose (bayt)"]
    api["backend: FastAPI<br/>:8000<br/>on start: alembic upgrade,<br/>seed, city.match --if-needed"]
    db[("db: Postgres 17 + PostGIS<br/>:5433, pgdata volume<br/>public: listings, listing_city_data,<br/>lot_analyses (30 d cache)<br/>city: parcels, zoning, address_points,<br/>permits, heritage")]
    imp["importer: GDAL ogr2ogr<br/>one-off, profile tools"]
  end

  subgraph ext["External"]
    gis["City of Toronto GIS<br/>ArcGIS REST"]
    ckan["Toronto Open Data<br/>CKAN"]
    cdn["cdn.realtor.ca<br/>listing photos"]
    ofm["OpenFreeMap<br/>vector tiles"]
  end

  seed["backend/seed/*.json.gz<br/>REALTOR.ca export from Apify"]

  browser -->|"HTTP"| fe
  fe -->|"server-side fetch only<br/>BACKEND_URL /api/*"| api
  browser -->|"next/image"| cdn
  browser -->|"MapLibre 3D lot view"| ofm
  api -->|"SQLAlchemy 2 / psycopg"| db
  api -->|"httpx, 6-8 queries per lot<br/>parcels, footprints, zoning, centrelines"| gis
  seed -.->|"python -m app.seed<br/>on empty database"| api
  ckan -->|"gpkg / csv, ~1 GB<br/>cached in data/city/"| imp
  imp -->|"loads city schema"| db
  start -.->|"docker compose up --wait<br/>(db + backend)"| api
  start -.->|"npx next dev"| fe
  start -.->|"city-data: run importer, then app.city.match<br/>lot-analysis: app.lot.backfill"| api
